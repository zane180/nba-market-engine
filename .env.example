# Copy to .env and fill in. Never commit .env.

# Storage (default: local SQLite)
ENGINE_DATABASE_URL=sqlite:///data/engine.db

# Kalshi API credentials (https://kalshi.com -> account -> API keys).
# Only needed for authenticated endpoints (portfolio, orders); public market
# data and the entire backtest work without them.
ENGINE_KALSHI_API_KEY_ID=
ENGINE_KALSHI_PRIVATE_KEY_PEM=

# Safety: real-money trading stays off unless this is true AND --live is passed
# AND the interactive confirmation is accepted. Leave false.
ENGINE_LIVE_TRADING_ENABLED=false
